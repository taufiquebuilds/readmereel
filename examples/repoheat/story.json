{
  "version": 2,
  "name": "repoheat",
  "url": "github.com/taufiquebuilds/repoheat",
  "install": "repoheat dashboard --user ratatui",
  "style": "midnight",
  "music": null,
  "scenes": [
    {
      "type": "hook",
      "lines": [
        "77 stars this week.",
        "You never noticed."
      ],
      "accentWords": [
        "noticed."
      ],
      "count": {
        "line": 0,
        "to": 77
      }
    },
    {
      "type": "title",
      "promise": "See which of your repos are heating up"
    },
    {
      "type": "terminal",
      "command": "repoheat pulse ratatui/ratatui",
      "output": [
        "ratatui/ratatui",
        "Stars        23,144",
        "Forks        820",
        "Last 2 days  +11",
        "Last 7 days  +66",
        "Viral score  49/100 · Warming up"
      ],
      "highlight": [
        5
      ]
    },
    {
      "type": "ui",
      "image": "examples/repoheat/dashboard-ratatui.png",
      "focus": [
        {
          "box": [
            430,
            80,
            300,
            420
          ],
          "label": "Stars gained in 7 and 2 days"
        },
        {
          "box": [
            740,
            280,
            520,
            120
          ],
          "label": "Every point explained"
        }
      ]
    },
    {
      "type": "list",
      "items": [
        "Stars gained, repo by repo",
        "A viral score, no black box",
        "Works on any public repo"
      ]
    },
    {
      "type": "end"
    }
  ]
}