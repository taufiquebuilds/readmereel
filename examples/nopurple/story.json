{
  "version": 2,
  "name": "nopurple",
  "url": "github.com/taufiquebuilds/nopurple",
  "install": "/plugin marketplace add taufiquebuilds/nopurple",
  "accent": "#d9480f",
  "style": "paper",
  "music": null,
  "scenes": [
    {
      "type": "hook",
      "lines": [
        "Blue gradients.",
        "Topic titles.",
        "Every AI deck."
      ],
      "accentWords": [
        "AI"
      ]
    },
    {
      "type": "title",
      "promise": "Slides and charts that look designed by a person"
    },
    {
      "type": "ui",
      "image": "examples/nopurple/real-before-after.png",
      "focus": [
        {
          "box": [
            642,
            76,
            636,
            358
          ],
          "label": "Without nopurple"
        },
        {
          "box": [
            642,
            510,
            636,
            364
          ],
          "label": "With nopurple"
        }
      ]
    },
    {
      "type": "counter",
      "items": [
        {
          "value": 41,
          "label": "Example AI deck",
          "note": "slop check, out of 100"
        },
        {
          "value": 100,
          "label": "With nopurple",
          "note": "slop check, out of 100"
        }
      ]
    },
    {
      "type": "compare",
      "before": {
        "label": "AI default",
        "points": [
          "Topic titles",
          "\"Significant growth\""
        ]
      },
      "after": {
        "label": "With nopurple",
        "points": [
          "The point as a sentence",
          "\"+13 points\""
        ]
      }
    },
    {
      "type": "end"
    }
  ]
}