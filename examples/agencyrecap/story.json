{
  "version": 2,
  "name": "agencyrecap",
  "url": "github.com/taufiquebuilds/agencyrecap",
  "install": "docker compose up -d",
  "accent": "#0f766e",
  "style": "midnight",
  "music": null,
  "scenes": [
    {
      "type": "hook",
      "lines": [
        "Every client.",
        "Every month.",
        "By hand."
      ],
      "accentWords": [
        "hand."
      ]
    },
    {
      "type": "title",
      "promise": "Monthly client reports that send themselves"
    },
    {
      "type": "ui",
      "html": "examples/agencyrecap/screens/dashboard.html",
      "focus": [
        {
          "box": [
            80,
            236,
            960,
            440
          ],
          "label": "Sent on each client's day"
        }
      ],
      "states": [
        {
          "at": 1.3,
          "selector": "#row2 .status, #row4 .status",
          "set": "sent"
        },
        {
          "at": 1.8,
          "selector": "#row1 .status",
          "set": "sent"
        },
        {
          "at": 2.35,
          "selector": "#row3 .status",
          "set": "sent"
        }
      ],
      "caption": "Sent. By itself."
    },
    {
      "type": "counter",
      "items": [
        {
          "value": 4812,
          "label": "Sessions",
          "note": "up 10%"
        },
        {
          "value": 126,
          "label": "Key events",
          "note": "up 7%"
        },
        {
          "value": 2140,
          "label": "Organic clicks",
          "note": "up 18%"
        }
      ]
    },
    {
      "type": "list",
      "items": [
        "Never sends a month twice",
        "Holds reports if Google fails",
        "Free for any number of clients"
      ]
    },
    {
      "type": "end"
    }
  ]
}