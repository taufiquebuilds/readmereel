{
  "version": 2,
  "name": "launchday",
  "url": "github.com/taufiquebuilds/launchday",
  "install": "/plugin marketplace add taufiquebuilds/launchday",
  "style": "midnight",
  "music": null,
  "scenes": [
    {
      "type": "hook",
      "lines": [
        "Good projects",
        "launch badly."
      ],
      "accentWords": [
        "badly."
      ]
    },
    {
      "type": "title",
      "promise": "A launch plan for one evening"
    },
    {
      "type": "ui",
      "image": "examples/launchday/social-preview.png",
      "focus": [
        {
          "box": [
            188,
            78,
            330,
            34
          ],
          "label": "Launch readiness score"
        },
        {
          "box": [
            195,
            150,
            460,
            40
          ],
          "label": "No demo in the first screen"
        }
      ]
    },
    {
      "type": "compare",
      "before": {
        "label": "unlaunched-cli: 20/100",
        "points": [
          "No screenshot, GIF or video",
          "No copy-paste install command"
        ]
      },
      "after": {
        "label": "repoheat: 100/100",
        "points": [
          "Image or GIF in the first screen",
          "Install command near the top"
        ]
      }
    },
    {
      "type": "list",
      "items": [
        "Checks your name before you ship",
        "Refuses to make things up",
        "Never publishes for you"
      ]
    },
    {
      "type": "end"
    }
  ]
}