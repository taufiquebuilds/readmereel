{
  "version": 2,
  "name": "readmereel",
  "url": "github.com/taufiquebuilds/readmereel",
  "install": "/plugin install readmereel@readmereel",
  "accent": "#f97316",
  "style": "midnight",
  "music": null,
  "scenes": [
    {
      "type": "hook",
      "lines": [
        "Nobody reads",
        "your README."
      ],
      "accentWords": [
        "README."
      ]
    },
    {
      "type": "title",
      "promise": "Your README as a launch film"
    },
    {
      "type": "compare",
      "before": {
        "label": "A README screenshot",
        "image": "examples/readmereel/agencyrecap-dashboard.png"
      },
      "after": {
        "label": "And its launch film",
        "image": "examples/readmereel/agencyrecap-frame.png"
      }
    },
    {
      "type": "counter",
      "items": [
        {
          "value": 8,
          "label": "Scene types"
        },
        {
          "value": 3,
          "label": "Styles"
        },
        {
          "value": 5,
          "label": "Transitions"
        }
      ]
    },
    {
      "type": "list",
      "items": [
        "Two sizes and a GIF, one run",
        "Only your real screenshots",
        "Free and local, no API keys"
      ]
    },
    {
      "type": "end"
    }
  ]
}